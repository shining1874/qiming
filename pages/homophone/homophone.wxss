.banner { border-radius: 18rpx; padding: 22rpx 24rpx; font-size: 25rpx; line-height: 1.6; margin-bottom: 8rpx; }
.banner-good { background: rgba(91,140,74,.14); color: #3F6B32; border: 1rpx solid rgba(91,140,74,.3); }
.banner-warn { background: var(--gold-s); color: var(--gold); border: 1rpx solid #E6D3B0; }
.banner-bad { background: var(--red-s); color: var(--red); border: 1rpx solid rgba(192,57,43,.25); }
.warn-card { background: var(--red-s); border: 1rpx solid rgba(192,57,43,.2); border-radius: 16rpx; padding: 18rpx 22rpx; margin-bottom: 14rpx; }
.warn-match { display: block; font-size: 28rpx; font-weight: 700; color: var(--red); letter-spacing: 2rpx; }
.warn-note { display: block; font-size: 22rpx; color: var(--ink2); margin-top: 6rpx; line-height: 1.5; }
.hint-row { display: flex; align-items: flex-start; gap: 16rpx; padding: 12rpx 0; border-bottom: 1rpx solid var(--bd); }
.hint-row:last-child { border-bottom: none; }
.hint-char { font-size: 40rpx; color: var(--ink); width: 56rpx; text-align: center; }
.hint-note { flex: 1; font-size: 24rpx; color: var(--ink2); line-height: 1.6; }
