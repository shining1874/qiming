.match-card { display: flex; flex-direction: column; align-items: center; padding: 36rpx 28rpx; }
.match-num { font-size: 96rpx; font-weight: 800; line-height: 1; letter-spacing: 2rpx; }
.match-tier { font-size: 30rpx; font-weight: 700; margin: 10rpx 0 14rpx; }
.pair-block { margin-bottom: 18rpx; }
.pair-block:last-child { margin-bottom: 0; }
.pair-block .label { display: block; margin-bottom: 10rpx; }
