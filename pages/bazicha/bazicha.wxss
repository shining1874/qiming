/* 八字排盘 · 页面样式 */
.pgrid { display: flex; gap: 12rpx; }
.pcol {
  flex: 1; text-align: center; background: var(--paper);
  border: 1rpx solid var(--bd); border-radius: 14rpx; padding: 14rpx 6rpx;
}
.pc-lab { font-size: 20rpx; color: var(--sub); }
.pc-gz { font-size: 38rpx; font-weight: 700; letter-spacing: 2rpx; color: var(--ink); margin: 4rpx 0; }
.pc-ss { font-size: 20rpx; color: var(--gold); line-height: 1.5; }
.pc-sub { font-size: 19rpx; color: var(--faint); line-height: 1.5; margin-top: 2rpx; }

.wxbar-row { display: flex; align-items: center; gap: 14rpx; margin: 10rpx 0; }
.wxbar-lab { width: 36rpx; font-weight: 700; font-size: 24rpx; }
.wxbar { flex: 1; }
.wxbar-num { width: 150rpx; text-align: right; font-size: 21rpx; color: var(--sub); }

.exp-title { font-size: 27rpx; font-weight: 700; color: var(--red); margin-bottom: 10rpx; }

.dt-row { display: flex; align-items: center; gap: 18rpx; padding: 10rpx 0; border-bottom: 1rpx dashed var(--bd); }
.dt-range { width: 150rpx; font-size: 23rpx; color: var(--ink2); }
.dt-gz { width: 90rpx; font-size: 28rpx; font-weight: 700; color: var(--ink); }
.dt-wx { font-size: 21rpx; color: var(--sub); }

.lock-card { text-align: center; }
.lock-emoji { font-size: 64rpx; }
.lock-title { font-size: 30rpx; font-weight: 700; color: var(--ink); margin: 12rpx 0; }
.lock-card .h-note { margin-bottom: 22rpx; }
