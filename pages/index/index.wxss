.hero {
  background: linear-gradient(160deg, #FFFDF8, #F3E9D6);
  border: 1rpx solid var(--bd);
  border-radius: 28rpx;
  padding: 48rpx 36rpx;
  display: flex; flex-direction: column; align-items: center;
  box-shadow: 0 8rpx 28rpx var(--sh);
  margin-bottom: 28rpx;
}
.hero-seal {
  width: 92rpx; height: 92rpx; border-radius: 18rpx;
  background: var(--red); color: #fff; font-size: 38rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  font-family: "STKaiti", serif; letter-spacing: 2rpx;
  box-shadow: 0 6rpx 16rpx rgba(192,57,43,.3);
}
.hero-title { font-size: 60rpx; font-weight: 700; color: var(--ink); margin-top: 18rpx; letter-spacing: 6rpx; }
.hero-sub { font-size: 25rpx; color: var(--ink2); margin-top: 12rpx; text-align: center; }
.hero-tip { font-size: 21rpx; color: var(--gold); margin-top: 14rpx; }

.promo {
  display: flex; align-items: center; justify-content: space-between;
  padding: 26rpx 28rpx; margin: 28rpx 0 22rpx;
  border: 1rpx solid #E6D3B0;
}
.promo-left { flex: 1; min-width: 0; }
.promo-title { font-size: 29rpx; font-weight: 700; color: var(--red); }
.promo-sub { font-size: 22rpx; color: var(--sub); margin-top: 8rpx; line-height: 1.6; }
.promo-btn {
  flex-shrink: 0; margin-left: 18rpx; padding: 16rpx 30rpx; border-radius: 999rpx;
  background: var(--red); color: #fff; font-size: 25rpx; font-weight: 600;
}
