<view class="page">

  <view class="seg" style="margin-bottom:22rpx">
    <view class="seg-item {{mode==='twin'?'on':''}}" data-m="twin" bindtap="setMode">双胞胎起名</view>
    <view class="seg-item {{mode==='sibling'?'on':''}}" data-m="sibling" bindtap="setMode">兄弟姐妹起名</view>
  </view>

  <view class="card card-pad">
    <view class="field">
      <view class="label">姓氏</view>
      <input class="input" placeholder="如：池、王、李" value="{{surname}}" bindinput="onSurname" maxlength="4" />
    </view>

    <block wx:if="{{mode==='twin'}}">
      <view class="field">
        <view class="label">风格</view>
        <view class="seg">
          <view class="seg-item {{style==='shared'?'on':''}}" data-s="shared" bindtap="setStyle">共享一字</view>
          <view class="seg-item {{style==='poem'?'on':''}}" data-s="poem" bindtap="setStyle">诗词对仗</view>
        </view>
      </view>
    </block>

    <block wx:if="{{mode==='sibling'}}">
      <view class="field">
        <view class="label">人数</view>
        <view class="seg">
          <view class="seg-item {{count===2?'on':''}}" data-c="2" bindtap="setCount">2 人</view>
          <view class="seg-item {{count===3?'on':''}}" data-c="3" bindtap="setCount">3 人</view>
          <view class="seg-item {{count===4?'on':''}}" data-c="4" bindtap="setCount">4 人</view>
        </view>
      </view>
      <view class="field">
        <view class="label">辈分字（可选，留空自动配）</view>
        <input class="input" placeholder="如：知、嘉、子" value="{{genChar}}" bindinput="onGen" maxlength="2" />
      </view>
    </block>

    <view class="btn btn-primary btn-block" bindtap="generate">生成组合</view>
  </view>

  <!-- 双胞胎 · 共享一字 -->
  <block wx:if="{{mode==='twin' && style==='shared' && result}}">
    <view class="rel-card card" wx:for="{{result}}" wx:key="shared" wx:for-item="r">
      <view class="rel-head">共享字 <text class="rel-shared serif">{{r.shared}}</text> <text class="faint">{{r.py}}</text></view>
      <view class="rel-pair">
        <view class="name-block" wx:for="{{r.pair}}" wx:key="name" wx:for-item="n">
          <view class="row-between">
            <text class="nb-name serif">{{n.name}}</text>
            <view class="star {{n.faved?'star-on':''}}" data-key="{{n.name}}|rel" data-name="{{n.name}}" data-py="{{n.py}}" data-yy="{{n.yy}}" bindtap="toggleFav">{{n.faved?'★':'☆'}}</view>
          </view>
          <view class="nb-yy">{{n.yy}}</view>
        </view>
      </view>
    </view>
  </block>

  <!-- 双胞胎 · 诗词对仗 -->
  <block wx:if="{{mode==='twin' && style==='poem' && result}}">
    <view class="rel-card card" wx:for="{{result}}" wx:key="sentence" wx:for-item="r">
      <view class="row-between"><view class="chip">{{r.cat}}</view><text class="faint" style="font-size:21rpx">{{r.book}}</text></view>
      <view class="sentence serif">「{{r.sentence}}」</view>
      <view class="rel-pair">
        <view class="name-block">
          <view class="row-between"><text class="nb-name serif">{{r.a.name}}</text><view class="star {{r.a.faved?'star-on':''}}" data-key="{{r.a.name}}|rel" data-name="{{r.a.name}}" data-py="{{r.a.py}}" data-yy="{{r.a.yy}}" bindtap="toggleFav">{{r.a.faved?'★':'☆'}}</view></view>
          <view class="nb-yy">{{r.a.yy}}</view>
        </view>
        <view class="name-block">
          <view class="row-between"><text class="nb-name serif">{{r.b.name}}</text><view class="star {{r.b.faved?'star-on':''}}" data-key="{{r.b.name}}|rel" data-name="{{r.b.name}}" data-py="{{r.b.py}}" data-yy="{{r.b.yy}}" bindtap="toggleFav">{{r.b.faved?'★':'☆'}}</view></view>
          <view class="nb-yy">{{r.b.yy}}</view>
        </view>
      </view>
    </view>
  </block>

  <!-- 兄弟姐妹 -->
  <block wx:if="{{mode==='sibling' && result}}">
    <view class="rel-card card">
      <view class="rel-head">辈分字 <text class="rel-shared serif">{{result.gen}}</text></view>
      <view class="sib-list">
        <view class="name-block" wx:for="{{result.names}}" wx:key="name" wx:for-item="n">
          <view class="row-between"><text class="nb-name serif">{{n.name}}</text><view class="star {{n.faved?'star-on':''}}" data-key="{{n.name}}|rel" data-name="{{n.name}}" data-py="{{n.py}}" data-yy="{{n.yy}}" bindtap="toggleFav">{{n.faved?'★':'☆'}}</view></view>
          <view class="nb-yy">{{n.yy}}</view>
        </view>
      </view>
    </view>
  </block>

  <view class="notice" style="margin-top:20rpx">
    关系起名注重兄弟姐妹/双胞胎之间的呼应、对仗与辈分传承，仅作文化参考；最终请以家庭喜好与读音和谐为准。
  </view>
  <view class="safe-bottom"></view>
</view>
